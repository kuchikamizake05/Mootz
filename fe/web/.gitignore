# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# public env template
!.env.example

# local pen.dev exports (reference only, never commit)
/.design-export/

# local demo photos from Mootz.pen (fictional, not approved for commit)
/public/demo/

# copied by scripts/copy-vendor.mjs
/public/vendor/

# Generated from the repository's landing/ source.
/public/landing/

# Playwright output
/test-results/
/playwright-report/
