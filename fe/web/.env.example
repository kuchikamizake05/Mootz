# Public browser configuration only. Backend secrets never belong here.
# Copy to .env.local for local development.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Same public Mootz Privy app as the backend (see docs/privy-setup.md).
NEXT_PUBLIC_PRIVY_APP_ID=cmvkda7qi01ks0gjt1mrmlydu
# Optional: only when a specific Privy App Client is used.
NEXT_PUBLIC_PRIVY_CLIENT_ID=
# Satellite mode only; restrict allowed origins in MapTiler. Empty disables Satellite.
NEXT_PUBLIC_MAPTILER_API_KEY=
NEXT_PUBLIC_MONAD_CHAIN_ID=143
# Verified Monad mainnet deployment (sc/abi/deployment.monad-mainnet.json). Never use fixture addresses.
NEXT_PUBLIC_MEET_REGISTRY_ADDRESS=0x6fcdc6f98ab1ead21ae44f1e57f1ffeb5d3a49ff
NEXT_PUBLIC_EVENT_COLLECTION_ADDRESS=0x3d368ee46756102b0e0567f846f5ad9fcdff8a01
# UI-only preview with labelled fictional fixtures (no backend). Never enable in a deployed demo.
NEXT_PUBLIC_DEMO_FIXTURES=
