# Copy to .env on the VPS only. Never copy development credentials here.
COMPOSE_PROJECT_NAME=mootz-production
MOOTZ_IMAGE_TAG=vps
API_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com
ALLOWED_ORIGINS=https://app.example.com
# Generate with openssl rand -hex 32; hex avoids URL password escaping issues.
POSTGRES_PASSWORD=
PRIVY_APP_ID=
# Single-quoted JWKS JSON, or PEM with literal \n sequences.
PRIVY_VERIFICATION_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=mootz-private-media
# Leave paired chain settings empty until verified deployment is available.
MEET_RPC_URL=
MEET_REGISTRY_ADDRESS=
EVENT_COLLECTION_RPC_URL=
EVENT_COLLECTION_ADDRESS=
EVENT_CLAIM_ISSUER_PRIVATE_KEY=
# Relayer key intentionally has no entry: no transaction worker starts here.
