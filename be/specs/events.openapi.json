{
  "openapi": "3.1.0",
  "info": {
    "title": "Mootz Event details and organizer check-in",
    "version": "0.3.0",
    "description": "Authenticated events and restricted organizer management. Access is granted by an operator outside HTTP. Organizer identity comes from the verified token. Creation is idempotent per organizer/clientRequestId. Revocation disables management. Collection mapping and contract administration remain operator-only."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Event": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "startsAt",
          "endsAt",
          "locationLabel",
          "location"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "locationLabel": {
            "type": [
              "string",
              "null"
            ]
          },
          "location": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "latitude",
                  "longitude"
                ],
                "properties": {
                  "latitude": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "longitude": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  }
                }
              }
            ],
            "description": "Organizer-selected public venue coordinates, never participant or Meet verification location. Null for events without a map pin."
          }
        }
      },
      "CreateEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clientRequestId",
          "title",
          "startsAt",
          "endsAt"
        ],
        "properties": {
          "clientRequestId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 10000
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "maxLength": 40
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "maxLength": 40
          },
          "locationLabel": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "location": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "latitude",
                  "longitude"
                ],
                "properties": {
                  "latitude": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "longitude": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  }
                }
              }
            ],
            "description": "Organizer-selected public venue coordinates, never participant or Meet verification location. Null for events without a map pin."
          }
        }
      },
      "OrganizerEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "startsAt",
          "endsAt",
          "locationLabel",
          "collectionStatus",
          "checkInCount",
          "location"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "locationLabel": {
            "type": [
              "string",
              "null"
            ]
          },
          "collectionStatus": {
            "type": "string",
            "enum": [
              "not_configured",
              "configured"
            ],
            "description": "Mapping status only; not claim availability or ownership."
          },
          "checkInCount": {
            "type": "integer",
            "minimum": 0
          },
          "location": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "latitude",
                  "longitude"
                ],
                "properties": {
                  "latitude": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "longitude": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  }
                }
              }
            ],
            "description": "Organizer-selected public venue coordinates, never participant or Meet verification location. Null for events without a map pin."
          }
        }
      }
    }
  },
  "paths": {
    "/v1/events": {
      "get": {
        "summary": "List all provisioned events in ascending startsAt/id order",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "nextCursor"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "title",
                          "description",
                          "startsAt",
                          "endsAt",
                          "locationLabel",
                          "location"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "title": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "startsAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "endsAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "locationLabel": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "location": {
                            "anyOf": [
                              {
                                "type": "null"
                              },
                              {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "latitude",
                                  "longitude"
                                ],
                                "properties": {
                                  "latitude": {
                                    "type": "number",
                                    "minimum": -90,
                                    "maximum": 90
                                  },
                                  "longitude": {
                                    "type": "number",
                                    "minimum": -180,
                                    "maximum": 180
                                  }
                                }
                              }
                            ],
                            "description": "Organizer-selected public venue coordinates, never participant or Meet verification location. Null for events without a map pin."
                          }
                        }
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid or missing bearer token"
          },
          "403": {
            "description": "Account setup required or organizer permission denied"
          },
          "404": {
            "description": "Event or target account not found"
          }
        }
      },
      "post": {
        "summary": "Create an event as an approved organizer",
        "description": "Trim title/location. End follows start and is in the future for new events. Timezone offsets required; stored in UTC. Matching retries return the original event, including after its end. Conflicting clientRequestId returns 409. Creates no onchain collection.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEvent"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "200": {
            "description": "Matching retry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid or missing bearer token"
          },
          "403": {
            "description": "Account setup required or organizer permission denied"
          },
          "404": {
            "description": "Event or target account not found"
          },
          "409": {
            "description": "New check-in outside server event window [startsAt,endsAt). Existing successful check-in retries preserve timestamp even afterward."
          }
        }
      }
    },
    "/v1/events/{id}": {
      "get": {
        "summary": "Read event metadata; does not grant private moment access",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "title",
                    "description",
                    "startsAt",
                    "endsAt",
                    "locationLabel",
                    "location"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "title": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "startsAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "endsAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "locationLabel": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "location": {
                      "anyOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "latitude",
                            "longitude"
                          ],
                          "properties": {
                            "latitude": {
                              "type": "number",
                              "minimum": -90,
                              "maximum": 90
                            },
                            "longitude": {
                              "type": "number",
                              "minimum": -180,
                              "maximum": 180
                            }
                          }
                        }
                      ],
                      "description": "Organizer-selected public venue coordinates, never participant or Meet verification location. Null for events without a map pin."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid or missing bearer token"
          },
          "403": {
            "description": "Account setup required or organizer permission denied"
          },
          "404": {
            "description": "Event or target account not found"
          }
        }
      }
    },
    "/v1/events/{id}/check-in": {
      "get": {
        "summary": "Read authenticated account's own check-in only",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "checkedIn",
                    "checkedInAt"
                  ],
                  "properties": {
                    "checkedIn": {
                      "type": "boolean"
                    },
                    "checkedInAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid or missing bearer token"
          },
          "403": {
            "description": "Account setup required or organizer permission denied"
          },
          "404": {
            "description": "Event or target account not found"
          }
        }
      }
    },
    "/v1/events/{id}/check-ins": {
      "post": {
        "summary": "Organizer records existing account attendance during event",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "checkedIn",
                    "checkedInAt"
                  ],
                  "properties": {
                    "checkedIn": {
                      "type": "boolean"
                    },
                    "checkedInAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid or missing bearer token"
          },
          "403": {
            "description": "Account setup required or organizer permission denied"
          },
          "404": {
            "description": "Event or target account not found"
          },
          "409": {
            "description": "New check-in outside server event window [startsAt,endsAt). Existing successful check-in retries preserve timestamp even afterward."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "accountId"
                ],
                "properties": {
                  "accountId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        },
        "description": "Requires an approved organizer who owns this event. Revoked organizers cannot record or retry attendance. Idempotent per event/account. New attendance is accepted only during the server event window."
      }
    },
    "/v1/me/organizer": {
      "get": {
        "summary": "Read own operator-granted organizer access",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "enabled"
                  ],
                  "properties": {
                    "enabled": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing bearer token"
          },
          "403": {
            "description": "Account setup required or organizer permission denied"
          }
        }
      }
    },
    "/v1/me/events": {
      "get": {
        "summary": "List only events owned by the approved organizer",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "items",
                    "nextCursor"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/OrganizerEvent"
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid or missing bearer token"
          },
          "403": {
            "description": "Account setup required or organizer permission denied"
          },
          "404": {
            "description": "Event or target account not found"
          },
          "409": {
            "description": "New check-in outside server event window [startsAt,endsAt). Existing successful check-in retries preserve timestamp even afterward."
          }
        }
      }
    }
  }
}
