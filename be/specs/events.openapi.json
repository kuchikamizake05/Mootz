{
  "openapi": "3.1.0",
  "info": {
    "title": "Mootz Event details and organizer check-in",
    "version": "0.1.0",
    "description": "Authenticated backend slice only. Events/organizer are provisioned through seed/admin database process; no public creation or role assignment. Organizer identity comes from verified token account. Event detail contains no organizer provider identity. Check-ins are atomically idempotent per event/account, not collection ownership, claim authorization, or completed Meet eligibility."
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "paths": {
    "/v1/events": {
      "get": {
        "summary": "List all provisioned events in ascending startsAt/id order",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 512
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "items",
                    "nextCursor"
                  ],
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "id",
                          "title",
                          "description",
                          "startsAt",
                          "endsAt",
                          "locationLabel"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "title": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "startsAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "endsAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "locationLabel": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        }
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid or missing bearer token"
          },
          "403": {
            "description": "Account setup required or organizer permission denied"
          },
          "404": {
            "description": "Event or target account not found"
          }
        }
      }
    },
    "/v1/events/{id}": {
      "get": {
        "summary": "Read event metadata; does not grant private moment access",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "title",
                    "description",
                    "startsAt",
                    "endsAt",
                    "locationLabel"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "title": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "startsAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "endsAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "locationLabel": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid or missing bearer token"
          },
          "403": {
            "description": "Account setup required or organizer permission denied"
          },
          "404": {
            "description": "Event or target account not found"
          }
        }
      }
    },
    "/v1/events/{id}/check-in": {
      "get": {
        "summary": "Read authenticated account's own check-in only",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "checkedIn",
                    "checkedInAt"
                  ],
                  "properties": {
                    "checkedIn": {
                      "type": "boolean"
                    },
                    "checkedInAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid or missing bearer token"
          },
          "403": {
            "description": "Account setup required or organizer permission denied"
          },
          "404": {
            "description": "Event or target account not found"
          }
        }
      }
    },
    "/v1/events/{id}/check-ins": {
      "post": {
        "summary": "Organizer records existing account attendance during event",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "checkedIn",
                    "checkedInAt"
                  ],
                  "properties": {
                    "checkedIn": {
                      "type": "boolean"
                    },
                    "checkedInAt": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "format": "date-time"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request"
          },
          "401": {
            "description": "Invalid or missing bearer token"
          },
          "403": {
            "description": "Account setup required or organizer permission denied"
          },
          "404": {
            "description": "Event or target account not found"
          },
          "409": {
            "description": "New check-in outside server event window [startsAt,endsAt). Existing successful check-in retries preserve timestamp even afterward."
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "accountId"
                ],
                "properties": {
                  "accountId": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
