{
 "openapi":"3.1.0","info":{"title":"Mootz reusable selfie reactions","version":"0.1.0","description":"Private selfie library; only sent reactions visible to current published moment audience. One replaceable reaction per account and moment. Soft library deletion hides reuse but preserves sent reactions and physical objects; garbage collection and retention policy remain pending. Storage URLs expire after 60 seconds; already issued URLs can remain usable until expiry after audience revocation. No Dots or streak changes."},
 "security":[{"bearerAuth":[]}],
 "paths":{
  "/v1/me/selfies":{"post":{"description":"Raw JPEG/PNG <=8MiB; decoder normalizes and strips metadata. Maximum five successful uploads per rolling minute, serialized per account.","requestBody":{"required":true,"content":{"image/jpeg":{"schema":{"type":"string","format":"binary"}},"image/png":{"schema":{"type":"string","format":"binary"}}}},"responses":{"201":{"description":"Saved {id,createdAt}"},"400":{"description":"Invalid image"},"401":{"description":"Unauthorized"},"403":{"description":"Account setup required"},"413":{"description":"Too large"},"429":{"description":"Upload limit"},"503":{"description":"Private storage unavailable"}}},"get":{"parameters":[{"$ref":"#/components/parameters/limit"},{"$ref":"#/components/parameters/cursor"}],"responses":{"200":{"description":"Own active library {items:[{id,createdAt,thumbnailUrl}],nextCursor}; newest first"},"400":{"description":"Invalid page"},"401":{"description":"Unauthorized"}}}},
  "/v1/me/selfies/{selfieId}":{"parameters":[{"name":"selfieId","in":"path","required":true,"schema":{"type":"string","format":"uuid"}}],"delete":{"responses":{"204":{"description":"Soft deleted; repeat idempotent"},"404":{"description":"Not owned or missing"}}}},
  "/v1/moments/{id}/reaction":{"parameters":[{"$ref":"#/components/parameters/id"}],"put":{"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["selfieId"],"properties":{"selfieId":{"type":"string","format":"uuid"}}}}}},"responses":{"200":{"description":"Saved or replaced {status:saved}"},"404":{"description":"Moment inaccessible/unpublished or selfie not active and owned"}}},"delete":{"responses":{"204":{"description":"Own reaction removed, including repeat"},"404":{"description":"Moment inaccessible/unpublished"}}}},
  "/v1/moments/{id}/reactions":{"parameters":[{"$ref":"#/components/parameters/id"}],"get":{"parameters":[{"$ref":"#/components/parameters/limit"},{"$ref":"#/components/parameters/cursor"}],"responses":{"200":{"description":"{items:[{id,accountId,createdAt,thumbnailUrl}],nextCursor}; newest first, replacement retains position"},"400":{"description":"Invalid page"},"404":{"description":"Moment inaccessible/unpublished"}}}}
 },
 "components":{"securitySchemes":{"bearerAuth":{"type":"http","scheme":"bearer","bearerFormat":"JWT"}},"parameters":{"id":{"name":"id","in":"path","required":true,"schema":{"type":"string","format":"uuid"}},"limit":{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":50,"default":20}},"cursor":{"name":"cursor","in":"query","schema":{"type":"string","maxLength":300},"description":"Opaque server cursor"}}}
}
