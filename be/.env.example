NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000
# Local development only; match the private PostgreSQL service in compose.yaml.
DATABASE_URL=postgresql://mootz:mootz_local_only@127.0.0.1:55432/mootz
# Configure both to enable authenticated profile APIs. No demo auth bypass.
PRIVY_APP_ID=
# Public SPKI PEM (literal \n line breaks), or a single-quoted public JWKS JSON object.
PRIVY_VERIFICATION_KEY=
# Server-owned EOA control-proof domain and wallet binding namespace.
WALLET_PROOF_DOMAIN=localhost:3001
WALLET_CHAIN_ID=143

# Supabase Storage only; application PostgreSQL stays in Docker.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=mootz-private-media
# Legacy service_role key is accepted instead of SUPABASE_SECRET_KEY.
# Never use a publishable/anon key here or expose this key to frontend code.
# Optional Meet runtime: fill only after registry deployment/code/roles are verified.
MEET_RPC_URL=
MEET_REGISTRY_ADDRESS=
# Dedicated relayer server key; never a participant, Privy or Supabase credential.
# Explicit opt-in; no worker or transaction starts automatically with the API.
RELAYER_ENABLED=false
RELAYER_PRIVATE_KEY=
# Optional Event collection reads. Configure only a verified deployment.
EVENT_COLLECTION_RPC_URL=
EVENT_COLLECTION_ADDRESS=
# Optional dedicated issuer key enables short-lived claim authorizations.
# The API signs vouchers locally; it does not send claim transactions.
EVENT_CLAIM_ISSUER_PRIVATE_KEY=
# Explicit opt-in for the separate claim worker; never starts with the API.
# Uses the dedicated RELAYER_PRIVATE_KEY above, distinct from the issuer key.
CLAIM_RELAYER_ENABLED=false

# RPC-prepared fee ceilings (whole gwei), not forced transaction fee values.
# Hard maxima: 1000 max fee / 100 priority. Lower only after signed queues drain.
MEET_RELAY_MAX_FEE_GWEI=500
MEET_RELAY_MAX_PRIORITY_FEE_GWEI=50
CLAIM_RELAY_MAX_FEE_GWEI=500
CLAIM_RELAY_MAX_PRIORITY_FEE_GWEI=50

# Separate read-only indexing/finality worker. Never signs or broadcasts.
# Supply verified deployment blocks; never guess them or reset existing cursors.
CHAIN_SYNC_ENABLED=false
CHAIN_SYNC_CHAIN_ID=143
CHAIN_SYNC_RPC_URL=
CHAIN_SYNC_MEET_START_BLOCK=
CHAIN_SYNC_COLLECTION_START_BLOCK=
