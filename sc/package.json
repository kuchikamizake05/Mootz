{
  "name": "@mootz/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24 <27",
    "npm": ">=11 <12"
  },
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "lint": "forge fmt --check && node --check scripts/smoke-local.mjs && node --check scripts/vectors.mjs && node --check scripts/export.mjs && node --check specs/typed-data.mjs",
    "vectors": "node scripts/vectors.mjs",
    "export": "node scripts/export.mjs",
    "check:artifacts": "node scripts/export.mjs --check && node scripts/vectors.mjs --check",
    "smoke:local": "node scripts/smoke-local.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "typescript": "5.9.3",
    "viem": "2.57.10"
  }
}
