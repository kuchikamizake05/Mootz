# Proposed variable names for the initial design, not an executable app contract.
# Reference inventory: web public configuration belongs in fe/web; server secrets in be.
# INT-01 must define module environment files before either client or backend is run.
# Pin provider/runtime integration during scaffolding; never commit actual secrets.
# Public configuration
NEXT_PUBLIC_PRIVY_APP_ID=
# Browser-visible MapTiler key: restrict allowed origins; empty until configured.
# Used for Satellite only; default Map remains OpenFreeMap.
NEXT_PUBLIC_MAPTILER_API_KEY=
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MEET_REGISTRY_ADDRESS=
NEXT_PUBLIC_EVENT_COLLECTION_ADDRESS=

# Server-only configuration
PRIVY_APP_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
EVENT_ISSUER_SIGNER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=

# Empty contract/key values are deliberate: no Mootz deployment exists yet.
